    "unit-core-arcCurve-5": {
      "information": {
        "description": "Testing .show() method of shape",
        "module": "core",
        "testType": "unit",
        "element": "arcCurve",
        "id": "unit-core-arcCurve-5"
      },
      "states": {
        "before": {
          "style": {}
        },
        "after": {
          "style": {
            "opacity": 1
          }
        }
      },
      "status": {
        "result": "pass",
        "totalPassedAssertions": 2,
        "totalFailedAssertions": 0
      },
      "assertions": [
        {
          "crossCheck": "library",
          "domain": "style",
          "property": "opacity",
          "expectedStatus": "pass",
          "checkType": "eq",
          "actual": 1,
          "expected": 1,
          "actualStatus": "pass"
        },
        {
          "crossCheck": "library",
          "domain": "style",
          "property": "opacity",
          "expectedStatus": "pass",
          "checkType": "neq",
          "actual": 1,
          "expected": 0,
          "actualStatus": "pass"
        }
      ]
    },
