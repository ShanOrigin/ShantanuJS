{
  "type": "module",
  "name": "shantanujs",
  "version": "0.1.0-beta.0",
  "description": "ShantanuJS – A zero-dependency, high-performance 2D animation library with advanced transformations, filters, and effects — all in a lightweight, modern TypeScript package.",
  "main": "dist/distribution/ShantanuJS.cjs",
  "module": "dist/distribution/ShantanuJS.esm.js",
  "browser": "dist/distribution/ShantanuJS.min.js",
  "types": "dist/distribution/types/index/index.d.ts",
  "exports": {
    ".": {
        "types": "./dist/distribution/types/index/index.d.ts",
      "import": "./dist/distribution/ShantanuJS.esm.js",
      "require": "./dist/distribution/ShantanuJS.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist && tsc --build --clean",
    "build": "npm run clean && tsc -p tsconfig.build.json && copyfiles -u 1 \"src/**/*.d.ts\" dist/distribution/types && rollup -c && npm run pack",
    "pack": "npm pack --pack-destination . --cache .npm-cache && npm cache clean --force --cache .npm-cache",
    "check:package": "node scripts/verify-package.mjs",
    "verify": "npm run build && npm run check:package && npm run cirdep:index",
    "lint": "eslint ./src --ext .ts",
    "tsc:watch": "tsc -w --preserveWatchOutput",
    "mzip": "zip -r -0 \"Shantanujs-backup-new-arc$(date +%Y-%m-%d-%H-%M-%S).zip\" src README.md index.html package.json CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md tsconfig.json",
    "cirdep:path": "dpdm -T --circular --warning --tsconfig tsconfig.json",
    "cirdep:index": "dpdm -T --circular --warning --tsconfig tsconfig.json ./src/index/index.ts",
    "bs": "browser-sync start --server --files './index.html,./dist' --ignore 'node_modules' --no-cache --reload-delay 200",
    "live": "live-server --watch=dist  --ignore=node_modules --no-browser --port=3000",
    "dev": "npm-run-all --parallel tsc:watch live",
    "test-server": "node src/tests/testingTool/file-server.ts",
    "testing": "npm-run-all --parallel dev test-server"
  },
  "keywords": [
    "Shantanujs",
    "Shantanuts",
    "shantanu" ,
    "2d animation",
    "2d graphics library",
    "2d rendering",
    "pivot transformation",
    "advanced transformations",
    "filters",
    "advanced animations",
    "curves"

  ],
  "author": "Shantanu Suryawanshi",
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "copyfiles": "^2.4.1",
    "dpdm": "^3.14.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "happy-dom": "^18.0.1",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "rollup": "^3.29.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.8.3"
  }
}
