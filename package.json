{
  "type": "module",
  "name": "Shantanu",
  "version": "1.0.0",
  "description": "Shantanu.js v1.0 – A zero-dependency, high-performance 2D animation library with advanced transformations, filters, and effects — all in a lightweight, modern TypeScript package.",
  "main": "dist/distribution/Shantanu.cjs.js",
  "module": "dist/distribution/Shantanu.esm.js",
  "browser": "dist/distribution/Shantanu.min.js",
  "types": "dist/distribution/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist .rpt2_cache && tsc --build --clean",
    "build": "npm run clean && rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:one": "vitest run",
    "lint": "eslint ./src --ext .ts",
    "gitsmartsync": "node scripts/gitSmartSync.js",
    "gitsmartpush": "node scripts/gitSmartPush.js",
    "tsc:watch": "tsc -w --preserveWatchOutput",
    "tsc:watch-pre-sync": "npm run gitsmartsync && npm run tsc:watch",
    "mzip": "zip -r -0 \"Shantanujs-backup-new-arc$(date +%Y-%m-%d-%H-%M-%S).zip\" scripts src README.md index.html package.json CHANGELOG.md FUTURE_FEATURES_LIST.md ARCHITECTURE.MODEL Custom_LICENSE.md COMMERCIAL_LICENSE.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md ROADMAP.md tsconfig.json",
    "cirdep:path": "dpdm -T --circular --warning --tsconfig tsconfig.json",
    "cirdep:visual": "dpdm -T --circular --warning --tsconfig tsconfig.json ./src/tests/shapes/rect/visualTest/visualAnimations.ts",
    "cirdep:index": "dpdm -T --circular --warning --tsconfig tsconfig.json ./src/index/index.ts",
    "bs": "browser-sync start --server --files './index.html,./dist' --ignore 'node_modules' --no-cache --reload-delay 200",
    "live": "live-server --watch=dist  --ignore=node_modules --no-browser --port=3000",
    "dev": "npm-run-all --parallel tsc:watch live",
    "dev:sync": "npm run gitsmartsync && npm run dev",
    "test-server": "npx ts-node src/tests/testingTool/fileServer.ts",
    "testing": "npm-run-all --parallel dev test-server"
  },
  "keywords": [
    "Shantanujs",
    "Shantanuts",
    "shantanu"
  ],
  "author": "Shantanu Suryawanshi",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "dpdm": "^3.14.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "live-server": "^1.2.2",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "rollup": "^3.29.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
