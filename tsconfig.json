
{
  "compilerOptions": {
    // ---- Target & Module ---- 
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["DOM", "ESNext"],
    // ---- Paths & Resolution ---- 
    "rootDir": "./src/",
    "outDir": "./dist/",
    "moduleResolution": "node",
    "resolveJsonModule": true,          // allow importing .json
    "allowJs": true,                    // allow .js imports
    "checkJs": false,                   // don’t type-check JS files
    "allowArbitraryExtensions": true,   // allow .d.ts / custom ext
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    //---- Incremental Build ---- 
    "incremental": true,
    "sourceMap": false,

    // ---- Strictness ---- 
    "strict": true,
    "skipLibCheck": true,


    //---- Types & Declarations ----
    "types": ["vitest/globals"] , 
    "noEmit" : false , // create .js files in src if true 
    "declaration": true , // create .d.ts in dist directory 
    "declarationDir": "./dist/distribution/types",
    "emitDeclarationOnly": false // it helps im creation 


  },

  "watchOptions": {
    "watchFile": "fixedPollingInterval",
    "watchDirectory": "fixedPollingInterval",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true
  },

  "include": ["src/index/**/*.ts"],     // only include your main entry points
  "exclude": [
    "src/tests/**",                      // exclude tests
    "src/**/*.test.ts",                  // exclude test files
    "src/**/visualTest/**",              // exclude visual test folders
    "src/shapes/customGeometricShapes/*.ts", // exclude if they’re placeholders
    "node_modules",
    "dist"
  ]



  /*
    // Recommended strictness flags
    "noUnusedLocals": true,        // Error on unused variables
    "noUnusedParameters": true,    // Error on unused function parameters
    "noImplicitReturns": true,     // Error if not all code paths return a value
    "noFallthroughCasesInSwitch": true, // Prevent fallthrough in switch statements
    "forceConsistentCasingInFileNames": true, // Ensure consistent casing in imports
    "noImplicitAny": true,         // Prevent implicit 'any' types
    "strictNullChecks": true,      // Enable strict null checking
    "strictFunctionTypes": true,   // Enable strict function type checking
    "strictBindCallApply": true,   // Enable strict bind/call/apply checking
    "allowUnreachableCode": false, // Disallow unreachable code
    "allowUnusedLabels": false     // Disallow unused labels
  }
  */
}








